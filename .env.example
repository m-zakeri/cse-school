# Copy this file to `.env` and fill in real values before running docker-compose.
# `.env` itself is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Security (required in production)
# ---------------------------------------------------------------------------
# JWT signing key. Anyone who knows this value can forge an admin token, so it
# must be unique per deployment and kept secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Minimum 32 characters. In development you may leave it unset and the backend
# will generate a throwaway key at startup.
SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (required in production)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Initial superadmin provisioning (required in production)
# ---------------------------------------------------------------------------
# Seeded on first startup only. Use at least 12 characters with mixed case,
# digits and symbols.
FIRST_SUPERUSER_EMAIL=admin@aut.ac.ir
FIRST_SUPERUSER_PASSWORD=
