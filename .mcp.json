{
  "mcpServers": {
    "postgres-mcp": {
      "command": "npx",
      "args": ["-y", "@ashish8545/postgresql-mcp"],
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/ce_school_db",
        "DB_HOST": "localhost",
        "DB_PORT": "5432",
        "DB_NAME": "ce_school_db",
        "DB_USER": "postgres",
        "DB_PASSWORD": "postgres"
      }
    }
  }
}
